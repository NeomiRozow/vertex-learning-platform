# Canonical list of environment variables. Copy to .env.local and fill in.
# Never commit real values.

# Clerk — https://dashboard.clerk.com → Configure → API Keys → Next.js
# Public. Safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
CLERK_SECRET_KEY=

# Sanity — https://www.sanity.io/manage
# Public. Safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-26
# Server only. Viewer token for the private dataset. Never expose to the browser.
SANITY_API_READ_TOKEN=

# PostHog — https://eu.posthog.com → Project settings → Project token
# Public. Safe to expose to the browser. Without it, PostHog sends no events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# EU ingest host. The server client sends events here.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
